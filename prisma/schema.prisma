generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
  edits     Edit[]

  @@map("users")
}

model Artist {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  slug       String    @unique
  genre      String?
  origin     String?
  formedYear Int?
  bio        String?   @db.Text
  imageUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  articles   Article[]

  @@map("artists")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.LongText
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int
  artistId  Int
  artist    Artist   @relation(fields: [artistId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
  edits     Edit[]

  @@index([artistId], map: "articles_artistId_fkey")
  @@index([authorId], map: "articles_authorId_fkey")
  @@map("articles")
}

model Edit {
  id        Int      @id @default(autoincrement())
  summary   String?
  createdAt DateTime @default(now())
  editorId  Int
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id])
  editor    User     @relation(fields: [editorId], references: [id])

  @@index([articleId], map: "edits_articleId_fkey")
  @@index([editorId], map: "edits_editorId_fkey")
  @@map("edits")
}
